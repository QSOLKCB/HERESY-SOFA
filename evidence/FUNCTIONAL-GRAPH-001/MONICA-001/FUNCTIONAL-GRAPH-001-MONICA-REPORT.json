  "complexity_assessment": {
    "edge_walk": {
      "auxiliary_space": "O(n) including answer, state bytearray, and temporary path; excluding input",
      "reason": "Each node is entered once, and each directed cycle is separately traversed once.",
      "worst_case_time": "O(n)"
    },
    "indegree_peel": {
      "auxiliary_space": "O(n) including answer, indegree array, queue, and removed order; excluding input",
      "reason": "Each edge contributes a constant number of degree and queue operations; residual cycles are labeled once.",
      "worst_case_time": "O(n)"
    },
    "path_index": {
      "auxiliary_space": "O(n) including answer, state, and temporary path; excluding input",
      "path_index_reason": "Same aggregate disjoint-path argument as signed_walk; a single path.index call may be linear in that path but not quadratic across the full outer traversal.",
      "worst_case_time": "O(n)"
    },
    "reverse_graph": {
      "auxiliary_space": "O(n) including answer, reverse-parent structure, seen/solved sets, queues, and per-walk position map; excluding input",
      "reason": "The functional graph has n edges, and reverse propagation solves each node once.",
      "worst_case_time": "O(n)"
    },
    "signed_walk": {
      "auxiliary_space": "O(n) including output answer and O(longest path) temporary path; excluding input",
      "path_index_reason": "path.index(v) runs only when that globally disjoint current path closes a cycle. The total length scanned by all such calls is at most n, because each node is appended to a current path once before it is finalized.",
      "worst_case_time": "O(n)"
    }
  },
